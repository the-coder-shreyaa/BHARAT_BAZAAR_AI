# Environment Variables for Bharat Bazaar AI
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///bharat_bazaar.db

# ─── API Server ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── Razorpay Payment Gateway ───────────────────────────────────────────────
# Get test keys from https://dashboard.razorpay.com/app/keys
# Leave blank to use simulation mode (no real payments)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# ─── LLM Configuration (Optional) ───────────────────────────────────────────
# The AI Buyer Agent works without an LLM (rule-based fallback).
# Set these for enhanced natural language understanding.
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxx
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
